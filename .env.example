# 이 파일을 .env 로 복사한 뒤 값을 채워 넣으세요. (.env 는 커밋되지 않습니다)
#
# ⚠️ 여기 있는 키들은 전부 "빌드 타임 전용" 입니다.
#    EXPO_PUBLIC_ 접두어를 붙이면 앱 번들 안에 그대로 박혀서, 앱을 뜯으면
#    누구나 키를 꺼낼 수 있습니다. 그래서 일부러 접두어를 빼 두었습니다.
#    이 키들은 내 PC 에서 수집 스크립트를 돌릴 때만 쓰이고, 앱에는 들어가지 않습니다.

# 도서관 정보나루 (https://www.data4library.kr) - 인증키 신청 후 승인 필요
# 쓰는 곳: npm run enrich  (도서관 주소·전화·운영시간·좌표 수집)
DATA4LIBRARY_KEY=

# 카카오 REST API 키 (https://developers.kakao.com > 내 애플리케이션 > 앱 키)
# 쓰는 곳: npm run geocode        (도서관 좌표·주소 보완)
#          npm run collect-nearby (주변 맛집·카페·문화시설 수집)
KAKAO_REST_KEY=

# ─────────────────────────────────────────────────────────────
# 앱 런타임 설정 (이건 앱에 들어갑니다)
# ─────────────────────────────────────────────────────────────

# 개발 중 mock 데이터를 강제로 쓰고 싶을 때만 true.
# 평소에는 수집된 JSON 을 그대로 씁니다.
EXPO_PUBLIC_USE_MOCK=false
