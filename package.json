{
  "name": "library-outing",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "qr": "node scripts/generate-qr-sheet.mjs",
    "check-data": "node scripts/check-data.mjs",
    "enrich": "node scripts/enrich-libraries.mjs",
    "geocode": "node scripts/geocode-libraries.mjs",
    "collect-nearby": "node scripts/collect-nearby.mjs",
    "extract-logo": "node scripts/extract-logo.mjs",
    "slice-mascot": "node scripts/slice-mascot-sheet.mjs \"assets/mascot/달곰이.png\"",
    "app-images": "node scripts/make-app-images.mjs",
    "build:android": "eas build --profile development --platform android",
    "build:ios": "eas build --profile development --platform ios",
    "build:preview": "eas build --profile preview --platform android"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "~14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~52.0.20",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.3",
    "expo-dev-client": "~5.0.20",
    "expo-font": "~13.0.2",
    "expo-linking": "~7.0.4",
    "expo-router": "~4.0.14",
    "expo-splash-screen": "~0.29.18",
    "expo-status-bar": "~2.0.0",
    "expo-system-ui": "~4.0.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "eas-cli": "^23.2.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "typescript": "^5.3.3"
  }
}
